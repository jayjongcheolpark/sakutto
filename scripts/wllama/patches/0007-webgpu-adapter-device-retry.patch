+static bool ggml_webgpu_debug_cap_d3d12_limits() {
+#ifdef __EMSCRIPTEN__
+    return EM_ASM_INT({
+               var v = (typeof globalThis !== 'undefined' && globalThis.__SAKUTTO_WEBGPU_DEBUG__) ?
+                           String(globalThis.__SAKUTTO_WEBGPU_DEBUG__) :
+                           '';
+               return (v === 'amd-rdna3' || v === 'intel-arc') ? 1 : 0;
+           }) != 0;
+#else
+    return false;
+#endif
+}
+
+// D3D12 on AMD and Intel commonly grants 2 GiB - 4, while some adapters report 4 GiB
+// maxBufferSize that requestDevice then rejects. See Dawn/D3D12 adapter limit mismatches.
+static void ggml_webgpu_cap_storage_limits(wgpu::Limits & limits) {
+    const uint64_t cap = 2147483644ull;
+    if (limits.maxStorageBufferBindingSize > cap) {
+        limits.maxStorageBufferBindingSize = cap;
+    }
+    if (limits.maxBufferSize > cap) {
+        limits.maxBufferSize = cap;
+    }
+}
